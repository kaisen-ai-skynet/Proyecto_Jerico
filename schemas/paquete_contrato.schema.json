{
  "$defs": {
    "Cotizacion": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CotizacionLinea"
          },
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "payment_terms": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Payment Terms",
          "type": "string"
        },
        "special_conditions": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Special Conditions"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "currency",
        "lines",
        "payment_terms"
      ],
      "title": "Cotizacion",
      "type": "object"
    },
    "CotizacionLinea": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "unit_price": {
          "minimum": 0,
          "title": "Unit Price",
          "type": "integer"
        }
      },
      "required": [
        "description",
        "quantity",
        "unit_price"
      ],
      "title": "CotizacionLinea",
      "type": "object"
    },
    "Lead": {
      "additionalProperties": false,
      "properties": {
        "agreed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreed Value"
        },
        "client_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Type"
        },
        "company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company"
        },
        "doc_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Number"
        },
        "doc_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Type"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "legal_rep": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Rep"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "phone_e164": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone E164"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "start_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Term"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "title": "Lead",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cotizacion": {
      "$ref": "#/$defs/Cotizacion"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "lead": {
      "$ref": "#/$defs/Lead"
    },
    "legal_basis": {
      "title": "Legal Basis",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "lead",
    "cotizacion",
    "version",
    "legal_basis",
    "generated_at"
  ],
  "title": "PaqueteContrato",
  "type": "object"
}
