# Configuración de scripts/servidor/backup_crm.sh y restore_crm.sh (spec 003).
# Copia en kaisen-server: ~/.config/jerico/backup-crm.env (chmod 600).
# SIN secretos: aquí no va ninguna llave privada ni token.

# Contenedor y volumen del CRM
CONTAINER=jerico-crm
DATA_DIR=/app/crm-data
VOLUME=jerico_crm_data

# Dónde quedan los backups cifrados (directorio 700, archivos 600)
BACKUP_DIR=$HOME/jerico-backups/crm

# Llave(s) age PÚBLICA(S), una por línea (age1...). La privada se queda en la
# laptop del CTO (~/.config/kaisen/jerico-backup.agekey) y en su gestor de contraseñas.
AGE_RECIPIENTS_FILE=$HOME/.config/jerico/backup-recipients.txt

# Días que se conservan los backups (máximo 30, tope legal J-08)
RETENTION_DAYS=14

# .env del despliegue, del que notify_cto.sh lee el token del bot y el SMTP (sin ejecutarlo)
ENV_FILE=$HOME/jerico/.env
