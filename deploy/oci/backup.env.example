# Copiar a /etc/jerico/backup.env (root:root, 600). NUNCA a Git con valores reales.
# Llave PÚBLICA age (age-keygen -y sobre tu llave privada, en tu laptop).
AGE_RECIPIENT=age1REEMPLAZAR
# remoto:bucket definido en /etc/jerico/rclone.conf
RCLONE_REMOTE=oci-backups:jerico-backups
RCLONE_CONFIG=/etc/jerico/rclone.conf
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=30
