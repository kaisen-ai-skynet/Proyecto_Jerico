# --- Asistente comercial con LLM (apagado por defecto; ver specs/001-ventas-crm/asistente-despliegue.md) ---
JERICO_CRM_ASSISTANT_ENABLED=false
# La llave y el modelo van SIN prefijo y SOLO en el .env real del servidor:
#   OPENAI_API_KEY=...   OPENAI_MODEL=gpt-6-luna   OPENAI_REASONING_EFFORT=low
JERICO_CRM_ASSISTANT_MAX_OUTPUT_TOKENS=600
JERICO_CRM_ASSISTANT_DAILY_TOKEN_CAP=60000
JERICO_CRM_ASSISTANT_USER_DAILY_CALLS=20
# Notas libres del lead hacia el LLM: apagadas por minimización (Ley 1581).
JERICO_CRM_ASSISTANT_INCLUDE_NOTES=false
