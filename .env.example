# Proyecto Jericó — variables de entorno v0
# Copiar a .env y completar. NUNCA commitear el .env real.

# --- LLM (cliente OpenAI-compatible) ---
# Base URL del gateway OpenAI-compatible (p. ej. proxy GLM/DeepSeek)
JERICO_LLM_BASE_URL=https://api.example.com/v1
JERICO_LLM_API_KEY=changeme
# Modelos pinedos (prohibido -latest / -preview en prod)
JERICO_LLM_MODEL_L1=glm-5.3-flash
JERICO_LLM_MODEL_L2=deepseek-flash
# Presupuesto y ruteo
JERICO_ROUTER_L2_KEYWORDS=codigo,auditoria,finanzas,arquitectura

# --- Servidor ---
JERICO_HOST=0.0.0.0
JERICO_PORT=8000
JERICO_LOG_LEVEL=INFO
# Token bearer para API/Siri/Telegram webhook
JERICO_API_TOKEN=changeme
# Telegram ID autorizado (whitelist, Protocolo Santiago)
JERICO_ALLOWED_TELEGRAM_IDS=2099727924

# --- Memoria (Fase 3+; vacío = fallback en memoria de proceso) ---
JERICO_REDIS_URL=
JERICO_POSTGRES_URL=

# --- Voz (Fase 3+; carpeta fuera del repo, con consentimiento) ---
JERICO_VOICES_DIR=voices
JERICO_STT_MODEL=small
JERICO_TTS_ENGINE=fish-s1-mini
