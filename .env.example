# Proyecto Jericó — copiar a .env. NUNCA commitear el .env real.
# El modelo no está fijo en código. Un gateway compartido (OpenRouter)
# o credenciales por nivel. Prohibido -latest / -preview.

# --- Gateway compartido (vale para todos los niveles si no hay override) ---
JERICO_LLM_BASE_URL=https://openrouter.ai/api/v1
JERICO_LLM_API_KEY=changeme
JERICO_LLM_TIMEOUT_S=30
JERICO_LLM_MAX_RETRIES=2

# IDs exactos del proveedor. Ejemplos reales, no obligatorios:
#   openai/gpt-4o-mini
#   deepseek/deepseek-chat
#   anthropic/claude-3.5-sonnet
#   glm-5.3-flash
#   deepseek-flash
JERICO_LLM_MODEL_L1=glm-5.3-flash
JERICO_LLM_MODEL_L2=deepseek-flash
# Vacío = L3 usa el modelo L2 hasta que definas uno de frontera.
JERICO_LLM_MODEL_L3=
JERICO_LLM_MODEL_VOICE=

# Override opcional por nivel (proveedores directos). Vacío = gateway compartido.
JERICO_LLM_BASE_URL_L1=
JERICO_LLM_API_KEY_L1=
JERICO_LLM_BASE_URL_L2=
JERICO_LLM_API_KEY_L2=
JERICO_LLM_BASE_URL_L3=
JERICO_LLM_API_KEY_L3=

# Ruteo. Excepciones evitan falsos positivos ("codigo postal" no es código).
JERICO_ROUTER_L2_KEYWORDS=codigo,auditoria,arquitectura,refactor,devops,sql,bug
JERICO_ROUTER_L3_KEYWORDS=finanzas,contrato,legal,juridico,rentabilidad,demanda
JERICO_ROUTER_L2_EXCEPTIONS=codigo postal,codigo de area,codigo de barras

# --- Servidor ---
JERICO_HOST=0.0.0.0
JERICO_PORT=8000
JERICO_LOG_LEVEL=INFO
JERICO_API_TOKEN=changeme
JERICO_RATE_LIMIT_PER_MIN=30
JERICO_ALLOWED_TELEGRAM_IDS=2099727924

# --- Memoria (vacío = proceso local) ---
JERICO_REDIS_URL=
JERICO_POSTGRES_URL=
JERICO_MEMORY_TTL_HOURS=24
JERICO_MEMORY_MAX_SESSIONS=100

# --- Voz (fuera del repo, con consentimiento) ---
JERICO_VOICES_DIR=voices
JERICO_STT_MODEL=small
JERICO_TTS_ENGINE=fish-s1-mini
