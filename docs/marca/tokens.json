{
  "brand": "Kaizen",
  "version": "1.0",
  "source": "Manual de Marca Kaizen v1.0 (octubre 2026)",
  "color": {
    "noche": "#14100C",
    "papel": "#FFFFFF",
    "oxido": "#A8481F",
    "tinta": "#17120D",
    "oxido_vivo": "#CD7041",
    "oro": "#B8862B",
    "papel_suave": "#F8F4ED",
    "papel_calido": "#EEE5D6",
    "noche_suave": "#201A14",
    "tinta_suave": "#62584D",
    "linea": "#E6DED2",
    "verde_azulado": "#2B6E63",
    "pizarra": "#3D5A73",
    "ciruela": "#6B3F5E"
  },
  "color_rules": {
    "proportion": {"neutrals": 0.7, "oxido": 0.2, "rest": 0.1},
    "min_contrast_text": 4.5,
    "min_contrast_large_graphics": 3.0,
    "graphics_only_on_papel": ["oxido_vivo", "oro"],
    "allowed_logo_backgrounds": ["noche", "papel", "papel_suave", "oxido"]
  },
  "font": {
    "display": {"family": "Zen Old Mincho", "weights": [700, 900], "fallback": "Georgia"},
    "body": {"family": "Work Sans", "weights": [400, 500, 600], "fallback": "Calibri"},
    "label": {"family": "JetBrains Mono", "weights": [600], "transform": "uppercase", "fallback": "Consolas"}
  },
  "logo": {
    "clear_space": "0.5 x symbol height",
    "min_screen_px": {"symbol_height": 24, "horizontal_width": 96},
    "min_print_mm": {"symbol": 8, "horizontal": 30},
    "files": {
      "horizontal_noche": "assets/logo/logo_horizontal_noche.png",
      "horizontal_papel": "assets/logo/logo_horizontal_papel.png",
      "simbolo_color": "assets/logo/simbolo_color.png",
      "simbolo_sobre_noche": "assets/logo/simbolo_sobre_noche.png",
      "simbolo_mono_negro": "assets/logo/simbolo_mono_negro.png",
      "simbolo_mono_blanco_sobre_noche": "assets/logo/simbolo_mono_blanco_sobre_noche.png",
      "outro_9x16": "assets/logo/outro_9x16.png"
    }
  },
  "copy": {
    "filosofia": "Del papel al futuro. Con la confianza como base.",
    "posicionamiento": "Primero entendemos. Después construimos.",
    "tagline": "Da el paso. Nosotros respondemos.",
    "mensaje_producto_web": "Menos operación a pulso. Más control real.",
    "forbidden_words": ["revolucionario", "disruptivo", "transformación digital", "soluciones innovadoras", "de última generación", "tripulación", "recupera el timón"],
    "forbidden_names": ["Kaisen", "Kaizen AI", "Kaizen.ai", "KaizenAI"]
  }
}
